FROM apache/airflow:2.9.1-python3.11

USER root

# Installer Docker CLI, Git et Sudo
RUN apt-get update && \
    apt-get install -y --no-install-recommends docker.io git sudo && \
    rm -rf /var/lib/apt/lists/* && \
    echo "airflow ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER airflow

RUN pip install --no-cache-dir \
    dbt-bigquery \
    pandas \
    requests \
    pyarrow \
    python-dotenv